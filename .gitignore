# Dependencies
.dart_tool/
.packages
.pub/
build/
coverage/

# IDE
.idea/
.vscode/
*.iml

# Environment files (NEVER commit these)
.env
.env.*
!.env.example
secrets-*.env

# Build-time env overrides (real values filled in locally)
# The placeholder templates env.staging.json / env.production.json
# ARE committed; only the *.local.json variants hold real secrets.
config/env.*.local.json
config/env.*.secret.json

# Android
android/local.properties
android/key.properties
*.keystore
*.jks

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec

# macOS
macos/Pods/
macos/Flutter/ephemeral/

# Linux
linux/flutter/ephemeral/

# Windows
windows/flutter/ephemeral/

# Generated
lib/generated/
*.g.dart
*.freezed.dart

# Local snapshots / archives (never commit one-off zips of source)
lib_files.zip

# Supabase
supabase/.temp/

# Local agent config (never commit local settings)
.claude/

# Node.js test runners (ephemeral — RLS/Paymob verification scripts)
node_modules/
package.json
package-lock.json

# IDE tool directories
.freebuff/

# Loop engineering
loop-ledger.json
