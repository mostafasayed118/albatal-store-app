# Dependencies
.dart_tool/
.packages
.pub/
build/
coverage/

# IDE
.idea/
.vscode/
*.iml

# Environment files (NEVER commit these)
.env
.env.*
!.env.example
secrets-*.env

# Build-time env overrides (real values filled in locally)
# The placeholder templates env.staging.json / env.production.json
# ARE committed; only the *.local.json variants hold real secrets.
config/env.*.local.json
config/env.*.secret.json

# Android
android/local.properties
android/key.properties
*.keystore
*.jks

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec

# macOS
macos/Pods/
macos/Flutter/ephemeral/

# Linux
linux/flutter/ephemeral/

# Windows
windows/flutter/ephemeral/

# Generated code — *.g.dart / *.freezed.dart are local build artifacts and
# stay untracked. EXCEPTION: lib/generated/ (flutter gen-l10n output) IS
# tracked on purpose — regeneration is byte-stable (`flutter gen-l10n`
# re-run produces zero diffs), so the 3 committed l10n files are the source
# of truth for CI builds without a gen step (AUD-013 reword).
*.g.dart
*.freezed.dart

# Local snapshots / archives (never commit one-off zips of source)
lib_files.zip

# Supabase
supabase/.temp/

# Local agent config (never commit local settings)
.claude/
.agents/
.openclaw/
.opencode/
skills/superpowers/

# Node.js test runners (ephemeral — RLS/Paymob verification scripts)
node_modules/
package.json
package-lock.json

# IDE tool directories
.freebuff/

# Superpowers local reports (never commit)
.superpowers-*

# Loop engineering
loop-ledger.json

.trees/

# Flutter tool transient state
.flutter
.flutter_tool_state
