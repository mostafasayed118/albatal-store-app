# Al Batal Elite — client configuration template
#
# SECURITY: this file documents ONLY the variables that are safe
# for the Flutter client to receive. Paymob keys, the Supabase
# service-role key, and any Edge Function secrets are NEVER
# shipped to the client — they live only in Supabase Edge
# Function environment / Supabase Vault.
#
# As of the P0 remediation the Flutter app no longer reads a
# `.env` file at runtime and `.env` is NOT packaged as an asset.
# Instead, build-time values are injected via
# `--dart-define-from-file=config/env.<env>.json`.
#
# Use this file as a reference when filling in:
#   config/env.staging.json
#   config/env.production.json
#
# NEVER commit a populated config/env.*.json containing real
# secrets. The staging/production JSON files in this repo are
# templates with placeholder values.

# Supabase project URL (safe — public client endpoint).
SUPABASE_URL=https://your-project.supabase.co

# Supabase public anon key (safe — designed for client use; RLS
# enforces all row-level access).
SUPABASE_ANON_KEY=your-anon-key-here

# Sentry DSN (optional — public, identifies the project, not a
# secret). Only set this if Sentry is approved and added to
# pubspec.yaml.
SENTRY_DSN=

# ---------------------------------------------------------------------------
# The following MUST NEVER appear in the Flutter client build:
#   PAYMOB_API_KEY          (Edge Function only)
#   PAYMOB_INTEGRATION_ID   (Edge Function only)
#   PAYMOB_HMAC_SECRET      (Edge Function only)
#   PAYMOB_IFRAME_ID        (Edge Function only)
#   SUPABASE_SERVICE_ROLE_KEY (server only — bypasses RLS)
#   SCHEDULER_SECRET        (Edge Function only)
# Configure these in: supabase functions secrets set <NAME>=<value>
# ---------------------------------------------------------------------------
