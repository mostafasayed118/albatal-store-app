From 5d494ae0936121500307326c1455e42cb137bee6 Mon Sep 17 00:00:00 2001
From: opencode <opencode@local>
Date: Tue, 15 Sep 2026 04:22:19 +0300
Subject: [PATCH 6/6] docs(storefront): drop stale cached_network_image TODO
 (already resolved via ProductImageResolver/AppImage) (AUD-010)

---
 lib/features/storefront/data/product_mapper.dart | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/lib/features/storefront/data/product_mapper.dart b/lib/features/storefront/data/product_mapper.dart
index 5309b9e..dcfca91 100644
--- a/lib/features/storefront/data/product_mapper.dart
+++ b/lib/features/storefront/data/product_mapper.dart
@@ -81,8 +81,9 @@ extension ProductCodec on Product {
     // Category name via the join.
     final category = safeString(safeMap(row['categories']), 'name');
 
-    // TODO: add cached_network_image for Storage URLs with Cache-Control max-age=86400
     // Map product_images → imageUrls via StorageService, ordered by sort_order.
+    // (Rendering is cached in the presentation layer: `ProductImageResolver`
+    // / `AppImage` wrap `CachedNetworkImage` for every remote product image.)
     final rawImages = row['product_images'];
     final imageRows = rawImages is List
         ? rawImages.whereType<Map<String, dynamic>>().toList()
